IPFS_CLUSTER_API=http://localhost:9096
IPFS_GATEWAY=http://localhost:8080
IPFS_CLUSTER_USER=admin
IPFS_CLUSTER_PASS=Agni@123

JWT_SECRET=change-me-to-random-hex

# JWT lifetime in hours (applies to mint_token.py and mock-wallet alike)
JWT_EXPIRY_HOURS=24

# Standalone qp-service only: when 0, POST /api/auth/mock-wallet returns 404.
# Keep 1 for dev/tests; production MUST set 0 (wallet addresses are public in
# the repo) and mint tokens offline with `python mint_token.py <address>`.
ENABLE_MOCK_WALLET=1

CORS_ORIGINS=http://localhost:5173,http://192.168.22.95:5173

MANIFESTS_FILE=./data/manifests.json
DEMO_DATA_DIR=./data/demo-data

MAX_FILE_SIZE_MB=500
IPFS_UPLOAD_TIMEOUT=300
IPFS_FETCH_TIMEOUT=120

# Storage node addresses (must be reachable from this server:
# daemon API on :5001, gateway on :8080)
NODE_1_IP=192.168.22.90
NODE_2_IP=192.168.22.91
NODE_3_IP=192.168.22.92
NODE_4_IP=192.168.22.93
NODE_5_IP=192.168.22.94

# Question-paper (SSS) endpoint
# 0 disables the size cap
QP_MAX_FILE_SIZE_MB=50
QP_ALLOWED_EXTENSIONS=pdf,doc,docx,png,jpg,jpeg
